    { "action": "tool.use", "resource": "shell:python -m pip install *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:python3 -m pip install *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:npm install *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:cargo install *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:go install *", "effect": "deny" },

    { "action": "tool.use", "resource": "shell:semgrep *", "effect": "deny" }
  ]
