    { "action": "tool.use", "resource": "shell:git checkout *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git commit", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git commit *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git stash", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git stash *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh auth status *--show-token*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh auth status *-t*", "effect": "deny" },

    { "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:su *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:mv *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sed -i *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sed *--in-place*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:find *-delete*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:chmod *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:truncate *", "effect": "deny" },
