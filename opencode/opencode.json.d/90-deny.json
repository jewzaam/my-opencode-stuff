    { "action": "tool.use", "resource": "shell:mkfs *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:dd *", "effect": "deny" },

    { "action": "tool.use", "resource": "shell:npm publish *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:twine upload *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gem push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:cargo publish *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:dotnet nuget push *", "effect": "deny" },

    { "action": "tool.use", "resource": "shell:nc *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:netcat *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:ncat *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:scp *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rsync *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sftp *", "effect": "deny" },
