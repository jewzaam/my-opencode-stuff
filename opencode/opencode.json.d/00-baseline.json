{
  "$schema": "https://opencode.ai/config.json",
  // Broadest rule: unmatched permissions ask. Later fragments allow specific
  // commands; 50-secrets and 90-deny close the dangerous cases last.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "env *", "effect": "deny" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" }
  ],
  "policies": [
    // Every shell deny needs a matching hard deny here; the test pins parity.
    { "action": "tool.use", "resource": "shell:env", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:env *", "effect": "deny" }
  ]
}